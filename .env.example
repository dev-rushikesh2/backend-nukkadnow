# ==============================================================================
# NukkadNow Backend Microservices Environment Configuration Template
# ==============================================================================

# Global Environment
NODE_ENV=development
LOG_LEVEL=debug
APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# API Gateway Ports
GATEWAY_PORT=4000
GATEWAY_PUBLIC_URL=http://localhost:4000

# Service Port Allocations
IDENTITY_SERVICE_PORT=4001
MERCHANT_SERVICE_PORT=4002
CATALOG_SERVICE_PORT=4003
DISCOVERY_SERVICE_PORT=4004
ORDER_SERVICE_PORT=4005
FULFILLMENT_SERVICE_PORT=4006
PAYMENT_SERVICE_PORT=4007
SUBSCRIPTION_SERVICE_PORT=4008
NOTIFICATION_SERVICE_PORT=4009
REVIEW_SUPPORT_SERVICE_PORT=4010
ANALYTICS_SERVICE_PORT=4011

# Security & Authentication (JWT / JWKS)
JWT_SECRET=local-development-secret-must-be-min-32-chars-long!
JWT_ISSUER=https://auth.nukkadnow.internal
JWT_AUDIENCE=nukkadnow-api
JWKS_URL=http://localhost:4001/.well-known/jwks.json
INTERNAL_SERVICE_SECRET=internal-service-hmac-mesh-secret-key-32chars

# Database Isolation per Microservice (PostgreSQL 16 + PostGIS)
# Pilot cluster compromise: 9 isolated databases with dedicated credentials
DATABASE_BASE_HOST=localhost
DATABASE_BASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

IDENTITY_DATABASE_URL="postgresql://identity_user:identity_pass@localhost:5432/identity_db?schema=public"
MERCHANT_DATABASE_URL="postgresql://merchant_user:merchant_pass@localhost:5432/merchant_db?schema=public"
CATALOG_DATABASE_URL="postgresql://catalog_user:catalog_pass@localhost:5432/catalog_db?schema=public"
DISCOVERY_DATABASE_URL="postgresql://discovery_user:discovery_pass@localhost:5432/discovery_db?schema=public"
ORDER_DATABASE_URL="postgresql://order_user:order_pass@localhost:5432/order_db?schema=public"
FULFILLMENT_DATABASE_URL="postgresql://fulfillment_user:fulfillment_pass@localhost:5432/fulfillment_db?schema=public"
PAYMENT_DATABASE_URL="postgresql://payment_user:payment_pass@localhost:5432/payment_db?schema=public"
SUBSCRIPTION_DATABASE_URL="postgresql://subscription_user:subscription_pass@localhost:5432/subscription_db?schema=public"
ANALYTICS_DATABASE_URL="postgresql://analytics_user:analytics_pass@localhost:5432/analytics_db?schema=public"

# Distributed Cache & Ephemeral Locking (Redis 7.2)
REDIS_URL="redis://:redis_local_pass@localhost:6379"

# Asynchronous Message Broker (RabbitMQ 3.13)
RABBITMQ_URL="amqp://nukkadnow:rabbitmq_local_pass@localhost:5672"
RABBITMQ_MANAGEMENT_URL="http://localhost:15672"

# Payment Service Provider (Razorpay / Cashfree / Mock PSP)
PAYMENT_PROVIDER=mock_psp
PAYMENT_KEY_ID=rzp_test_dummykey
PAYMENT_KEY_SECRET=rzp_test_dummysecret
PAYMENT_WEBHOOK_SECRET=webhook_signing_secret_xyz

# Object Storage (S3 / MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=nukkadnow-media
OBJECT_STORAGE_REGION=ap-south-1

# Observability & Telemetry (OpenTelemetry)
OTEL_SERVICE_NAME=nukkadnow-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_PATH=/metrics
