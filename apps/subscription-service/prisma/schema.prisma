datasource db {
  provider = "postgresql"
  url      = env("SUBSCRIPTION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SubscriptionPlan {
  id           String                 @id @default(uuid())
  name         String
  code         String                 @unique // STARTER, GROWTH, ENTERPRISE
  pricePaise   Int
  billingCycle String                 @default("MONTHLY")
  features     Json
  createdAt    DateTime               @default(now())
  subs         MerchantSubscription[]

  @@map("subscription_plans")
}

model MerchantSubscription {
  id                 String           @id @default(uuid())
  merchantId         String           @unique
  planId             String
  status             String           @default("ACTIVE")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  invoices           Invoice[]

  @@map("merchant_subscriptions")
}

model Entitlement {
  id          String   @id @default(uuid())
  merchantId  String
  featureCode String
  isEnabled   Boolean  @default(true)
  limitValue  Int?
  updatedAt   DateTime @updatedAt

  @@unique([merchantId, featureCode])
  @@map("entitlements")
}

model Invoice {
  id             String               @id @default(uuid())
  subscriptionId String
  merchantId     String
  amountPaise    Int
  status         String               @default("PAID")
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime             @default(now())
  subscription   MerchantSubscription @relation(fields: [subscriptionId], references: [id])

  @@map("invoices")
}
