datasource db {
  provider = "postgresql"
  url      = env("FULFILLMENT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

model CapacitySlot {
  id             String            @id @default(uuid())
  tenantId       String?           // Merchant Organization ID
  outletId       String
  slotDate       String            // "YYYY-MM-DD"
  startTime      String            // "10:00"
  endTime        String            // "10:30"
  maxCapacity    Int               @default(10)
  reservedCount  Int               @default(0)
  version        Int               @default(1) // Optimistic concurrency lock
  isWalkIn       Boolean           @default(false)
  reservations   SlotReservation[]

  @@unique([outletId, slotDate, startTime])
  @@index([tenantId, outletId])
  @@map("capacity_slots")
}

model SlotReservation {
  id        String       @id @default(uuid())
  slotId    String
  orderId   String       @unique
  status    String       @default("RESERVED") // RESERVED, CONFIRMED, EXPIRED
  expiresAt DateTime
  createdAt DateTime     @default(now())
  slot      CapacitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("slot_reservations")
}

model QueueSnapshot {
  id                String   @id @default(uuid())
  outletId          String
  activeOrdersCount Int
  waitMinutes       Int
  observedAt        DateTime @default(now())

  @@index([outletId, observedAt])
  @@map("queue_snapshots")
}

model PickupToken {
  id          String   @id @default(uuid())
  orderId     String   @unique
  tenantId    String?  // Merchant Organization ID
  outletId    String
  tokenNumber String   // "A-12"
  status      String   @default("ISSUED") // ISSUED, READY, COLLECTED
  createdAt   DateTime @default(now())

  @@index([outletId, status])
  @@index([tenantId, outletId])
  @@map("pickup_tokens")
}

model DeliveryTask {
  id              String   @id @default(uuid())
  orderId         String   @unique
  tenantId        String?  // Merchant Organization ID
  outletId        String
  cityCode        String   @default("IN-MH-NGP") // Municipal city boundary
  deliveryAddress String
  status          String   @default("PENDING")
  assignedStaffId String?
  createdAt       DateTime @default(now())

  @@index([cityCode, status])
  @@index([tenantId, outletId])
  @@map("delivery_tasks")
}

model OutletTokenSequence {
  id           String   @id @default(uuid())
  outletId     String   @map("outlet_id")
  seqDate      String   @map("seq_date")
  lastSequence Int      @default(1) @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([outletId, seqDate])
  @@map("outlet_token_sequences")
}
