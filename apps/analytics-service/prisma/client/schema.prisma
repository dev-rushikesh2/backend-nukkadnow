datasource db {
  provider = "postgresql"
  url      = env("ANALYTICS_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

model DailyMetric {
  id                 String   @id @default(uuid())
  metricDate         String // "YYYY-MM-DD"
  outletId           String
  cityCode           String   @default("IN-MH-NGP") // Municipal partition (IN-MH-NGP, IN-MH-AKL, IN-MH-PUN, IN-MH-AMR)
  totalOrders        Int      @default(0)
  totalSalesPaise    BigInt   @default(0)
  avgPrepTimeMinutes Float    @default(0)
  updatedAt          DateTime @updatedAt

  @@unique([metricDate, outletId])
  @@index([cityCode, metricDate])
  @@map("daily_metrics")
}

model PlatformReportingFact {
  id                   String @id @default(uuid())
  factDate             String // "YYYY-MM-DD"
  cityCode             String @default("GLOBAL") // "GLOBAL" or city partition
  totalGmvPaise        BigInt @default(0)
  activeMerchantsCount Int    @default(0)
  activeCustomersCount Int    @default(0)
  totalOrdersFulfilled Int    @default(0)

  @@unique([factDate, cityCode])
  @@map("platform_reporting_facts")
}
