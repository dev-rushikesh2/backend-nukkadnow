datasource db {
  provider = "postgresql"
  url      = env("REVIEW_SUPPORT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

model Review {
  id             String   @id @default(uuid())
  orderId        String
  reviewScopeKey String?  @unique // ORDER:<orderId> or PRODUCT:<orderId>:<productId>
  customerId     String
  customerName   String?
  outletId       String
  productId      String?
  productName    String?
  cityCode       String   @default("IN-MH-NGP") // Municipal partition (IN-MH-NGP, IN-MH-AKL, IN-MH-PUN, IN-MH-AMR)
  rating         Int      // 1 to 5
  comment        String?
  isModerated    Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([outletId])
  @@index([productId])
  @@index([customerId])
  @@index([cityCode, isModerated])
  @@map("reviews")
}

model SupportTicket {
  id           String          @id @default(uuid())
  ticketNumber String          @unique
  customerId   String
  tenantId     String?
  orderId      String?
  cityCode     String          @default("IN-MH-NGP") // Municipal partition
  subject      String
  status       String          @default("OPEN")
  priority     String          @default("NORMAL")
  createdAt    DateTime        @default(now())
  messages     TicketMessage[]

  @@index([customerId])
  @@index([cityCode, status])
  @@index([cityCode, priority])
  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  senderId   String
  senderRole String        // CUSTOMER, AGENT
  message    String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}
