datasource db {
  provider = "postgresql"
  url      = env("CATALOG_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

model Product {
  id              String           @id @default(uuid())
  tenantId        String // Merchant Organization ID
  outletId        String // Merchant Outlet ID
  masterProductId String? // Optional reference to MasterProductTemplate
  name            String
  description     String?
  category        String
  subCategory     String?
  imageUrl        String?
  isAvailable     Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  variants        ProductVariant[]

  @@index([tenantId, outletId])
  @@index([outletId, isAvailable])
  @@index([outletId, masterProductId])
  @@index([category])
  @@map("products")
}

model ProductVariant {
  id                  String             @id @default(uuid())
  productId           String
  masterVariantId     String? // Optional reference to MasterVariantTemplate
  tenantId            String? // Denormalized Merchant Org ID for direct variant tenant checks
  outletId            String? // Denormalized Merchant Outlet ID
  name                String
  sku                 String?
  barcode             String?
  pricePaise          Int
  compareAtPricePaise Int? // MRP or benchmark reference
  isPreorder          Boolean            @default(false)
  leadTimeMinutes     Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockBalance        StockBalance?
  stockReservations   StockReservation[]
  stockMovements      StockMovement[]

  @@index([productId])
  @@index([tenantId, outletId])
  @@map("product_variants")
}

model MasterProductTemplate {
  id            String                  @id @default(uuid())
  code          String                  @unique // e.g. MC-SABJI-TOMATO
  name          String
  description   String?
  storeTypes    String[] // e.g. ["SABJI_MANDI"], ["GENERAL_STORE"]
  category      String
  subCategory   String?
  searchAliases String[] // Local keywords e.g. ["tamatar", "tomato"]
  gstPercent    Float                   @default(0)
  imageUrl      String?
  emoji         String?                 @default("📦")
  isActive      Boolean                 @default(true)
  sortOrder     Int                     @default(100)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  variants      MasterVariantTemplate[]

  @@index([isActive, sortOrder])
  @@index([category])
  @@map("master_product_templates")
}

model MasterVariantTemplate {
  id                  String                @id @default(uuid())
  templateId          String
  name                String // e.g. "500g", "1kg"
  skuPrefix           String?
  barcode             String?
  suggestedPricePaise Int
  mrpPaise            Int?
  defaultStock        Int                   @default(25)
  unitLabel           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  template            MasterProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([barcode])
  @@map("master_variant_templates")
}

model StockBalance {
  id               String         @id @default(uuid())
  variantId        String         @unique
  tenantId         String // Strict multi-tenant boundary key — no default; must be set explicitly
  outletId         String
  onHandQuantity   Int            @default(0) // Protected by non-negative constraint
  reservedQuantity Int            @default(0)
  safetyStock      Int            @default(5)
  version          Int            @default(1) // Optimistic concurrency lock
  updatedAt        DateTime       @updatedAt
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, outletId])
  @@index([outletId])
  @@map("stock_balances")
}

model StockMovement {
  id             String          @id @default(uuid())
  variantId      String
  tenantId       String // Multi-tenant boundary — no default; must be set explicitly
  outletId       String
  quantityChange Int // Negative for deductions, positive for additions
  balanceAfter   Int             @default(0)
  reason         String // RESTOCK, ORDER_RESERVATION, SALE_COMMIT, RESERVATION_RELEASE, DAMAGE_WASTE, RETURN_RESTOCK, AUDIT_CORRECTION
  actorId        String          @default("SYSTEM")
  referenceId    String?
  notes          String?
  createdAt      DateTime        @default(now())
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, outletId, createdAt])
  @@index([variantId])
  @@index([outletId, createdAt])
  @@map("stock_movements")
}

model StockReservation {
  id        String         @id @default(uuid())
  variantId String
  tenantId  String // Multi-tenant boundary — no default; must be set explicitly
  outletId  String
  quantity  Int
  orderId   String
  expiresAt DateTime
  status    String         @default("ACTIVE") // ACTIVE, COMMITTED, EXPIRED, RELEASED
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, outletId])
  @@index([orderId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

model AdminPriceCapRule {
  id            String   @id @default(uuid())
  scope         String   @default("CATEGORY") // GLOBAL, CATEGORY, LOCALITY, SPECIFIC_PRODUCT
  targetKey     String // e.g. "Dairy & Milk", "Nagpur-Central", or "*"
  maxPricePaise Int // Maximum allowed selling price in paise
  enforceMrpCap Boolean  @default(true) // If true, price cannot exceed compareAtPricePaise
  reason        String
  isActive      Boolean  @default(true)
  createdBy     String   @default("PLATFORM_ADMIN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([scope, targetKey, isActive])
  @@map("admin_price_cap_rules")
}
