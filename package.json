{
  "name": "nukkadnow-backend-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NukkadNow Backend Microservices Monorepo - Enterprise Grade Architecture",
  "author": "NukkadNow Engineering",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "start:all": "node infrastructure/scripts/start-microservices.js",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:contract": "turbo run test:contract",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "prisma:generate": "turbo run prisma:generate",
    "prisma:migrate": "turbo run prisma:migrate",
    "clean": "turbo run clean && rimraf node_modules",
    "docker:up": "docker compose -f infrastructure/docker/compose.local.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/compose.local.yml down",
    "docker:obs:up": "docker compose -f infrastructure/docker/compose.observability.yml up -d",
    "docker:obs:down": "docker compose -f infrastructure/docker/compose.observability.yml down",
    "generate:openapi": "turbo run generate:openapi"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.2.3",
    "typescript": "^6.0.3"
  }
}
